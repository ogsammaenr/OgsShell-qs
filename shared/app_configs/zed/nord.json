{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Nord",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Nord",
      "appearance": "dark",
      "style": {
        "border": "#4c566a",
        "elevation.shadow": "#00000080",
        "surface.background": "#2e3440",
        "background": "#2e3440",
        "element.background": "#3b4252",
        "element.hover": "#434c5e",
        "element.active": "#4c566a",
        "element.selected": "#4c566a",
        "text": "#eceff4",
        "text.muted": "#d8dee9",
        "text.accent": "#88c0d0",
        "status_bar.background": "#2e3440",
        "title_bar.background": "#2e3440",
        "toolbar.background": "#2e3440",
        "tab_bar.background": "#2e3440",
        "tab.active_background": "#2e3440",
        "tab.inactive_background": "#2e3440",
        "editor.background": "#2e3440",
        "editor.foreground": "#eceff4",
        "editor.gutter.background": "#2e3440",
        "editor.line_number": "#4c566a",
        "editor.active_line_number": "#88c0d0",
        "project_panel.background": "#272c36",
        "panel.background": "#272c36",
        "dock.background": "#272c36",
        "workspace.background": "#2e3440",
        "syntax": {
          "keyword": { "color": "#81a1c1" },
          "function": { "color": "#88c0d0" },
          "string": { "color": "#a3be8c" },
          "comment": { "color": "#616e88" },
          "type": { "color": "#8fbcbb" },
          "variable": { "color": "#eceff4" }
        }
      }
    }
  ]
}
