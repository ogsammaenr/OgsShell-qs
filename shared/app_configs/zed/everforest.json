{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Everforest Dark Hard",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Everforest Dark Hard",
      "appearance": "dark",
      "style": {
        "border": "#475258",
        "elevation.shadow": "#00000080",
        "surface.background": "#2d353b",
        "background": "#2d353b",
        "element.background": "#343f44",
        "element.hover": "#475258",
        "element.active": "#504945",
        "element.selected": "#504945",
        "text": "#d3c6aa",
        "text.muted": "#859289",
        "text.accent": "#a7c080",
        "status_bar.background": "#232a2e",
        "title_bar.background": "#232a2e",
        "toolbar.background": "#2d353b",
        "tab_bar.background": "#232a2e",
        "tab.active_background": "#2d353b",
        "tab.inactive_background": "#232a2e",
        "editor.background": "#2d353b",
        "editor.foreground": "#d3c6aa",
        "editor.gutter.background": "#2d353b",
        "editor.line_number": "#504945",
        "editor.active_line_number": "#a7c080",
        "project_panel.background": "#232a2e",
        "panel.background": "#232a2e",
        "dock.background": "#232a2e",
        "workspace.background": "#2d353b",
        "syntax": {
          "keyword": { "color": "#e67e80" },
          "function": { "color": "#a7c080" },
          "string": { "color": "#dbbc7f" },
          "comment": { "color": "#859289" },
          "type": { "color": "#7fbbb3" },
          "variable": { "color": "#d3c6aa" }
        }
      }
    }
  ]
}
