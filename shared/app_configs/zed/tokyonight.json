{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Tokyo Night",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Tokyo Night",
      "appearance": "dark",
      "style": {
        "border": "#292e42",
        "elevation.shadow": "#00000080",
        "surface.background": "#1a1b26",
        "background": "#1a1b26",
        "element.background": "#24283b",
        "element.hover": "#292e42",
        "element.active": "#3b4261",
        "element.selected": "#3b4261",
        "text": "#c0caf5",
        "text.muted": "#565f89",
        "text.accent": "#7aa2f7",
        "status_bar.background": "#16161e",
        "title_bar.background": "#16161e",
        "toolbar.background": "#1a1b26",
        "tab_bar.background": "#16161e",
        "tab.active_background": "#1a1b26",
        "tab.inactive_background": "#16161e",
        "editor.background": "#1a1b26",
        "editor.foreground": "#c0caf5",
        "editor.gutter.background": "#1a1b26",
        "editor.line_number": "#3b4261",
        "editor.active_line_number": "#7aa2f7",
        "project_panel.background": "#16161e",
        "panel.background": "#16161e",
        "dock.background": "#16161e",
        "workspace.background": "#1a1b26",
        "syntax": {
          "keyword": { "color": "#bb9af7" },
          "function": { "color": "#7aa2f7" },
          "string": { "color": "#9ece6a" },
          "comment": { "color": "#565f89" },
          "type": { "color": "#2ac3de" },
          "variable": { "color": "#c0caf5" }
        }
      }
    }
  ]
}
