{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Catppuccin Mocha",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Catppuccin Mocha",
      "appearance": "dark",
      "style": {
        "border": "#45475a",
        "elevation.shadow": "#00000080",
        "surface.background": "#1e1e2e",
        "background": "#1e1e2e",
        "element.background": "#313244",
        "element.hover": "#45475a",
        "element.active": "#585b70",
        "element.selected": "#585b70",
        "text": "#cdd6f4",
        "text.muted": "#a6adc8",
        "text.accent": "#cba6f7",
        "status_bar.background": "#181825",
        "title_bar.background": "#181825",
        "toolbar.background": "#1e1e2e",
        "tab_bar.background": "#181825",
        "tab.active_background": "#1e1e2e",
        "tab.inactive_background": "#181825",
        "editor.background": "#1e1e2e",
        "editor.foreground": "#cdd6f4",
        "editor.gutter.background": "#1e1e2e",
        "editor.line_number": "#585b70",
        "editor.active_line_number": "#cba6f7",
        "project_panel.background": "#181825",
        "panel.background": "#181825",
        "dock.background": "#181825",
        "workspace.background": "#1e1e2e",
        "syntax": {
          "keyword": { "color": "#cba6f7" },
          "function": { "color": "#89b4fa" },
          "string": { "color": "#a6e3a1" },
          "comment": { "color": "#6c7086" },
          "type": { "color": "#f9e2af" },
          "variable": { "color": "#cdd6f4" }
        }
      }
    }
  ]
}
