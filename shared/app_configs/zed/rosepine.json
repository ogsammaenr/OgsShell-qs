{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Rosé Pine",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Rosé Pine",
      "appearance": "dark",
      "style": {
        "border": "#26233a",
        "elevation.shadow": "#00000080",
        "surface.background": "#191724",
        "background": "#191724",
        "element.background": "#1f1d2e",
        "element.hover": "#26233a",
        "element.active": "#403d52",
        "element.selected": "#403d52",
        "text": "#e0def4",
        "text.muted": "#6e6a86",
        "text.accent": "#ebbcba",
        "status_bar.background": "#1f1d2e",
        "title_bar.background": "#1f1d2e",
        "toolbar.background": "#191724",
        "tab_bar.background": "#1f1d2e",
        "tab.active_background": "#191724",
        "tab.inactive_background": "#1f1d2e",
        "editor.background": "#191724",
        "editor.foreground": "#e0def4",
        "editor.gutter.background": "#191724",
        "editor.line_number": "#6e6a86",
        "editor.active_line_number": "#ebbcba",
        "project_panel.background": "#1f1d2e",
        "panel.background": "#1f1d2e",
        "dock.background": "#1f1d2e",
        "workspace.background": "#191724",
        "syntax": {
          "keyword": { "color": "#31748f" },
          "function": { "color": "#ebbcba" },
          "string": { "color": "#f6c177" },
          "comment": { "color": "#6e6a86" },
          "type": { "color": "#9ccfd8" },
          "variable": { "color": "#e0def4" }
        }
      }
    }
  ]
}
