{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Monochrome High Contrast",
  "author": "OgsShell-qs",
  "themes": [
    {
      "name": "Monochrome High Contrast",
      "appearance": "dark",
      "style": {
        "border": "#333333",
        "elevation.shadow": "#00000080",
        "surface.background": "#121212",
        "background": "#121212",
        "element.background": "#1e1e1e",
        "element.hover": "#333333",
        "element.active": "#444444",
        "element.selected": "#444444",
        "text": "#ffffff",
        "text.muted": "#888888",
        "text.accent": "#ffffff",
        "status_bar.background": "#0a0a0a",
        "title_bar.background": "#0a0a0a",
        "toolbar.background": "#121212",
        "tab_bar.background": "#0a0a0a",
        "tab.active_background": "#121212",
        "tab.inactive_background": "#0a0a0a",
        "editor.background": "#121212",
        "editor.foreground": "#ffffff",
        "editor.gutter.background": "#121212",
        "editor.line_number": "#555555",
        "editor.active_line_number": "#ffffff",
        "project_panel.background": "#0a0a0a",
        "panel.background": "#0a0a0a",
        "dock.background": "#0a0a0a",
        "workspace.background": "#121212",
        "syntax": {
          "keyword": { "color": "#f472b6", "weight": 700 },
          "function": { "color": "#60a5fa" },
          "string": { "color": "#4ade80" },
          "number": { "color": "#fbbf24" },
          "comment": { "color": "#64748b", "font_style": "italic" },
          "type": { "color": "#38bdf8" },
          "variable": { "color": "#e2e8f0" },
          "property": { "color": "#cbd5e1" },
          "operator": { "color": "#94a3b8" },
          "constant": { "color": "#f472b6" }
        }
      }
    }
  ]
}
